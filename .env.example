# Copy this file to .env and fill in your values. Never commit .env.

# Required. Get a key at https://metalpriceapi.com
METALPRICE_API_KEY=

# How long to reuse data before calling the provider again, in seconds.
# These defaults use about 90 requests a month, within the 100-request free plan.
# The free plan updates daily, so shorter lifetimes only help on a paid plan.
PRICE_CACHE_SECONDS=43200
HISTORY_CACHE_SECONDS=86400

# Server address. Use HOST=0.0.0.0 only behind a firewall or reverse proxy.
HOST=127.0.0.1
PORT=5000

# Optional location of the on-disk cache.
# CACHE_PATH=instance/market-cache.json
