# Copy this file to .env and fill in your values. Never commit .env.

# Optional. Live prices need no key. A free key from https://gold-api.com makes the
# history chart use Gold API spot prices. Without one it uses Yahoo Finance futures.
GOLD_API_KEY=

# How long to reuse data before calling the provider again, in seconds.
# Gold API updates about every 30 seconds and bans clients that send bursts of requests.
PRICE_CACHE_SECONDS=60
HISTORY_CACHE_SECONDS=86400

# Server address. Use HOST=0.0.0.0 only behind a firewall or reverse proxy.
HOST=127.0.0.1
PORT=5000

# Optional location of the on-disk cache.
# CACHE_PATH=instance/market-cache.json
